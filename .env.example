# Database connection (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parsi_db?schema=public"

# Google Gemini (FREE method via Google AI Studio - https://aistudio.google.com/apikey)
# Free-tier API key. Powers Task 1: document parsing (transcription + vision extraction).
GEMINI_API_KEY="your-gemini-free-api-key"

# DeepSeek (PAID method via DeepSeek platform - https://platform.deepseek.com)
# Paid OpenAI-compatible API key. Power Task 2: follow-up executive summarization.
# Requires topping up credit on the DeepSeek platform.
DEEPSEEK_API_KEY="your-deepseek-paid-api-key"

# Storage Configuration - Cloudflare R2 (S3-compatible) is the default target.
# The app speaks the S3 protocol, so it works against R2 OR real AWS S3.
#
# --- Cloudflare R2 setup ---
# 1. Dashboard -> R2 -> Create Bucket (e.g. "parsi-receipts").
# 2. R2 -> Manage R2 API Tokens -> Create API Token -> Object Read & Write -> save.
#    The token gives you an Access Key ID + Secret Access Key (put them below).
# 3. Account ID is the 32-char hex id on your R2 overview page.
AWS_ENDPOINT="https://<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com"
AWS_REGION="auto"
AWS_ACCESS_KEY_ID="<r2-token-access-key-id>"
AWS_SECRET_ACCESS_KEY="<r2-token-secret-access-key>"
AWS_S3_BUCKET="parsi-receipts"
#
# --- Real AWS S3 alternative ---
# Remove AWS_ENDPOINT, use your IAM keys + a real region instead:
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="AKIA..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_S3_BUCKET="parsi-receipts"

# Inngest Background Queue Configuration
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Application Environment
NODE_ENV="development"